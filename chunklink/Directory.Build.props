<Project>
  <!--
    TccDir aponta para o código-fonte do TCC (procgen-flow-matching).
    Ordem de busca: -p:TccDir=... na linha de comando; ./tcc-vendor (cópia empacotada
    na entrega); a pasta pai, quando o ChunkLink está dentro do repositório do TCC (branch
    chunklink); ../procgen-flow-matching (clone irmão do repositório público).
  -->
  <PropertyGroup Condition="'$(TccDir)' == '' And Exists('$(MSBuildThisFileDirectory)tcc-vendor')">
    <TccDir>$(MSBuildThisFileDirectory)tcc-vendor/</TccDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TccDir)' == '' And Exists('$(MSBuildThisFileDirectory)../c2-pcg.flow-matching')">
    <TccDir>$(MSBuildThisFileDirectory)../</TccDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TccDir)' == ''">
    <TccDir>$(MSBuildThisFileDirectory)../procgen-flow-matching/</TccDir>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Avisos de nulidade vindos dos arquivos do TCC (compilados sem #nullable). -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8603;CS8625</NoWarn>
  </PropertyGroup>
</Project>
