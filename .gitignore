# Build output
bin/
obj/
build/

# IDE
.vs/
.idea/
*.user
*.suo

# User-specific environment
*.DS_Store
Thumbs.db

# NuGet
*.nupkg
packages/

# VGLC dataset (not redistributed; cloned separately by user)
TheVGLC/

# Sprites extracted from VGLC (regenerated locally via scripts/extract-sprites.py)
sprites/

# Per-run generation artifacts (PNGs, checkpoints, loss logs)
generated-png*/
*.bin
*.bin.step*
loss-log*.csv
loss-curve*.png

# Python virtual environment (created locally via `python3 -m venv .venv`)
.venv/
__pycache__/
*.pyc

# Core dumps
core.*

# Editor backups
*.bak

# Config files contain secrets (DB password, etc.); commit only *.example.txt templates
config/*.txt
!config/*.example.txt

# Docker secrets; commit only the *.example.txt placeholder
secrets/*.txt
!secrets/*.example.txt
