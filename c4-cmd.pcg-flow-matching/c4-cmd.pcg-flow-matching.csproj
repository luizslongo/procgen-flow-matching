<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>c4_cmd.pcgFlowMatching</RootNamespace>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../c2-pcg.flow-matching/c2-pcg.flow-matching-dataloader/c2-pcg.flow-matching-dataloader.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="TorchSharp-cuda-windows" Condition="'$(OS)' == 'Windows_NT' And '$(UseCPU)' != 'true'" />
        <PackageReference Include="TorchSharp-cuda-linux" Condition="'$(OS)' != 'Windows_NT' And '$(UseCPU)' != 'true'" />
        <PackageReference Include="TorchSharp-cpu" Condition="'$(UseCPU)' == 'true'" />
    </ItemGroup>
</Project>
